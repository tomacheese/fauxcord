{
  // Production build config: excludes test files, test helpers, spec tooling, and scripts from dist output.
  // Type checking (pnpm run lint) uses tsconfig.json which includes spec/ and scripts/.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/test-helpers.ts",
    "src/spec-contract.test.ts",
    "spec",
    "scripts"
  ]
}
