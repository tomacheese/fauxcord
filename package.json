{
  "name": "fauxcord",
  "version": "1.0.0",
  "description": "Discord REST API v10 Mock Server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*",
    "spec:fetch": "tsx scripts/spec-fetch.ts",
    "spec:diff": "tsx scripts/spec-diff.ts",
    "spec:update": "tsx scripts/spec-fetch.ts spec/openapi.json"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.7.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@hono/node-server": "2.0.8",
    "better-sqlite3": "12.11.1",
    "discord-api-types": "0.38.49",
    "hono": "4.12.30",
    "tsx": "4.23.1",
    "ws": "8.21.1"
  }
}
