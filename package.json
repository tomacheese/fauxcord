{
  "name": "fauxcord",
  "version": "1.0.0",
  "description": "Discord REST API v10 Mock Server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fuzz": "tsx src/model-based-explorer.ts",
    "fuzz:short": "tsx src/model-based-explorer.ts --seed 24301 --steps 48",
    "fuzz:full": "tsx src/model-based-full-explorer.ts --seed 24301",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*",
    "spec:fetch": "tsx scripts/spec-fetch.ts",
    "spec:diff": "tsx scripts/spec-diff.ts",
    "spec:update": "tsx scripts/spec-fetch.ts spec/openapi.json"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.71",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.9.9",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "better-sqlite3": "13.0.3",
    "discord-api-types": "0.38.56",
    "hono": "4.13.13",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  }
}
