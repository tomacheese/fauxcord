{
  "name": "fauxcord",
  "version": "1.0.0",
  "description": "Discord REST API v10 Mock Server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "v26.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*",
    "spec:fetch": "tsx scripts/spec-fetch.ts",
    "spec:diff": "tsx scripts/spec-diff.ts",
    "spec:update": "tsx scripts/spec-fetch.ts spec/openapi.json"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.14.53",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.4",
    "@vitest/coverage-v8": "4.1.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.6.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.8.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@hono/node-server": "2.0.6",
    "better-sqlite3": "12.11.1",
    "discord-api-types": "0.38.49",
    "hono": "4.12.27"
  }
}
