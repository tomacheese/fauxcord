<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>DiscordNetVerify</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Discord.Net.Rest only (no Discord.Net.WebSocket, no Discord.Net.Webhook):
      this verifier exercises the bot-authenticated REST surface only.

      Version note: docs/libraries.md states "verified with 3.20.0", but that
      exact version could not be confirmed to exist on NuGet at the time this
      file was written (no network access available to check). 3.15.2 is a
      3.x release the author is confident was actually published; if 3.20.0
      (or a later 3.x) is in fact published, bump this pin accordingly.
    -->
    <PackageReference Include="Discord.Net.Rest" Version="3.15.2" />
  </ItemGroup>

</Project>
