<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      InvariantGlobalization must stay OFF: Discord.Net.Rest parses locale strings (e.g.
      Guild.PreferredLocale) via CultureInfo.GetCultureInfo(name), which throws under
      invariant-globalization mode for any non-invariant culture name. That's a verifier
      self-inflicted limitation, not a real Fauxcord/Discord.Net compatibility issue
      (confirmed via a real run: GET /guilds/{guild_id} failed with "Only the invariant
      culture is supported in globalization-invariant mode" until this was turned off).
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>DiscordNetVerify</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Discord.Net.Rest for the bot-authenticated REST surface, plus
      Discord.Net.WebSocket for the Gateway (DiscordSocketClient) verification
      below. No Discord.Net.Webhook: token-authenticated webhook endpoints
      are out of scope (see the notes at the top of Program.cs).

      Version note: confirmed via the NuGet flat-container index
      (https://api.nuget.org/v3-flatcontainer/discord.net.rest/index.json)
      that 3.20.1 is the latest published stable release, matching what
      docs/libraries.md claims ("verified with 3.20.0"). The previous 3.15.2
      pin lacked RestTextChannel.GetPrivateArchivedThreadsAsync /
      GetPublicArchivedThreadsAsync / GetJoinedPrivateArchivedThreadsAsync
      (confirmed by a real CS1061 compile failure against 3.15.2), which the
      official docs.discordnet.dev API reference documents as present on
      RestTextChannel — so this bump is required, not just a nice-to-have.
      Discord.Net.WebSocket is pinned to the same 3.20.1 version since it
      ships from the same Discord.Net release train as Discord.Net.Rest.
    -->
    <PackageReference Include="Discord.Net.Rest" Version="3.20.1" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
  </ItemGroup>

</Project>
